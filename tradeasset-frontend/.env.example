# Copy to .env.local and adjust. Never commit real credentials.

# Base URL of the TradeAsset API. Leave empty to call the same origin
# (the Vite dev server proxies /api to VITE_DEV_PROXY_TARGET).
VITE_API_BASE_URL=

# Dev server only: where /api requests are proxied to.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Request timeout in milliseconds. A timeout is reported as "outcome unknown", never as a failure.
VITE_API_TIMEOUT_MS=30000
